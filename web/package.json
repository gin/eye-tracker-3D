{
  "name": "eye-tracker-3d",
  "packageManager": "pnpm@10.11.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA demo: webcam head/eye tracking driving on-screen gaze selection and monocular-depth pseudo-3D parallax for images and video.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "gen:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "^0.6.0",
      "sharp": "$sharp",
      "brace-expansion": "^5.0.8"
    }
  }
}
